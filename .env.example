# Set these in Netlify → Site configuration → Environment variables (never commit real values).

# Paymob dashboard → Settings → Account info (use the TEST keys while testing)
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=

# Paymob integration IDs per checkout option (Developers → Payment integrations), e.g.
# {"card":[123456],"bank":[123457],"inst":[123458,123459],"wallet":[123460],"insta":[123461]}
PAYMOB_INTEGRATIONS=

# The live site address, e.g. https://seeneyewear.com (used for Paymob's return and callback URLs)
SITE_URL=

# Optional: where paid orders are POSTed as JSON (Google Apps Script, Zapier, Make, Slack…)
ORDER_WEBHOOK_URL=

# Customer accounts: a long random string that signs the sign-in cookie (e.g. from `openssl rand -hex 32`)
SESSION_SECRET=

# Optional: promo codes and their discount, e.g. {"SEEN10":0.1}
PROMO_CODES=

# Optional: home delivery fee in EGP
DELIVERY_FEE=
