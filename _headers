# Photos: keep in the browser for a day, and serve the stored copy instantly while checking for a new one in the background (up to a week).
# (Not "immutable": banners and product photos get replaced under the same name.)
/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Translation files change rarely: keep an hour, then show the stored copy while checking for a new one in the background.
/lang/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Self-hosted fonts: the file names carry a hash of the original, so they can be kept for a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/fonts.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Parked material (not part of the site).
/parked/*
  X-Robots-Tag: noindex
